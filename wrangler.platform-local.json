{
  "name": "taiwan-startup-park-runtime-local",
  "main": "platform/runtime/worker.mjs",
  "compatibility_date": "2026-10-04",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": false,
  "vars": {
    "APP_ENV": "local",
    "DEMO_MODE": "on",
    "PLATFORM_RUNTIME_ENABLED": "on"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "startup-park-address-local-only",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "remote": false
    },
    {
      "binding": "PLATFORM_DB",
      "database_name": "startup-park-platform-local-only",
      "database_id": "00000000-0000-0000-0000-000000000001",
      "remote": false
    }
  ],
  "assets": {
    "directory": ".migration-build/smart-menu/frontend/dist",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*",
      "/platform/*"
    ]
  }
}

{
  "name": "taiwan-startup-park",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.14.0"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsc && node scripts/build.mjs",
    "test": "npm run build && node --test tests/core.test.mjs",
    "dev": "npm run build && node scripts/dev.mjs",
    "test:e2e": "playwright test",
    "worker:check": "wrangler deploy --dry-run --outdir .worker-build"
  },
  "devDependencies": {
    "typescript": "5.9.3",
    "@playwright/test": "1.63.0",
    "wrangler": "4.147.0"
  }
}
